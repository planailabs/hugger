{
  "manifest_version": 3,
  "name": "hugger — one-click model archiver",
  "version": "0.1.0",
  "description": "Archive HuggingFace models to your hugger server with one click.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["defaults.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hugger@plan.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  },
  "action": {
    "default_title": "hugger",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://huggingface.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
